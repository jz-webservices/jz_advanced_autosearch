<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        TophygieneSearchBar
        Überschreibt das Standard-eCommerce-Suchfeld mit
        einem OWL-Widget das asynchrone Live-Vorschau liefert.
    -->
    <t t-name="tophygiene_search.SearchBar" owl="1">
        <div class="o_tophygiene_search_wrapper" t-ref="wrapper">

            <!-- Suchfeld (ersetzt das native input) -->
            <div class="o_tophygiene_search_input_wrap">
                <input
                    type="search"
                    class="o_tophygiene_search_input form-control"
                    t-ref="input"
                    t-att-value="state.query"
                    t-att-placeholder="props.placeholder or 'Produkte suchen...'"
                    t-on-input="onInput"
                    t-on-keydown="onKeydown"
                    t-on-focus="onFocus"
                    autocomplete="off"
                    name="search"
                />
                <button
                    class="o_tophygiene_search_btn btn"
                    t-on-click="submitSearch"
                    aria-label="Suchen"
                >
                    <!-- Lupe Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                         viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                    </svg>
                </button>
            </div>

            <!-- Dropdown Ergebnisse -->
            <div
                class="o_tophygiene_search_dropdown"
                t-if="state.isOpen"
                t-ref="dropdown"
            >
                <!-- Loading State -->
                <div class="o_tophygiene_search_loading" t-if="state.isLoading">
                    <span class="o_tophygiene_spinner"/>
                    <span>Suche läuft...</span>
                </div>

                <!-- Keine Ergebnisse -->
                <div
                    class="o_tophygiene_search_empty"
                    t-elif="!state.isLoading and state.results.length === 0 and state.query.length >= 1"
                >
                    <span>Keine Produkte gefunden für "<strong t-esc="state.query"/>"</span>
                </div>

                <!-- Ergebnisse vorhanden -->
                <t t-elif="state.results.length > 0">

                    <!-- Kategorie-Schnellfilter -->
                    <div class="o_tophygiene_search_categories" t-if="state.categories.length > 1">
                        <span class="o_tophygiene_search_label">In Kategorie:</span>
                        <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                            <a
                                class="o_tophygiene_search_cat_badge"
                                t-att-href="cat.url"
                                t-esc="cat.name"
                            />
                        </t>
                    </div>

                    <!-- Produktliste -->
                    <div class="o_tophygiene_search_products">
                        <t t-foreach="state.results" t-as="product" t-key="product.id">
                            <a
                                class="o_tophygiene_search_product_item"
                                t-att-href="product.product_url"
                            >
                                <!-- Produktbild -->
                                <div class="o_tophygiene_search_product_img">
                                    <img
                                        t-att-src="product.image_url"
                                        t-att-alt="product.name"
                                        loading="lazy"
                                    />
                                </div>
                                <!-- Produktinfos -->
                                <div class="o_tophygiene_search_product_info">
                                    <span class="o_tophygiene_search_product_name"
                                          t-esc="product.name"/>
                                    <span class="o_tophygiene_search_product_categ"
                                          t-esc="product.categ_name"/>
                                    <div class="o_tophygiene_search_product_prices">
                                        <span class="o_tophygiene_search_product_price_excl"
                                              t-esc="product.price_excl + ' exkl. MwSt.'"/>
                                        <span class="o_tophygiene_search_product_price_incl"
                                              t-esc="product.price_incl + ' inkl. MwSt.'"/>
                                    </div>
                                </div>
                                <!-- Pfeil -->
                                <svg class="o_tophygiene_search_arrow"
                                     xmlns="http://www.w3.org/2000/svg"
                                     width="16" height="16" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M9 18l6-6-6-6"/>
                                </svg>
                            </a>
                        </t>
                    </div>

                    <!-- Footer: Alle Ergebnisse anzeigen -->
                    <a
                        class="o_tophygiene_search_footer"
                        t-att-href="state.totalUrl"
                    >
                        ALLE ANZEIGEN (<t t-esc="state.totalCount"/>)
                    </a>

                </t>
            </div>
        </div>
    </t>

</templates>
