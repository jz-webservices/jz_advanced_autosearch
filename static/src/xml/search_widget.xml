<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Überschreibt das native Odoo-Template mit leerem Inhalt.
        Verhindert das native OWL-Dropdown — das eigentliche Dropdown
        wird durch unser Vanilla-JS übernommen.
        Verwendet t-inherit statt t-name um "already exists"-Konflikt zu vermeiden.
    -->
    <t t-inherit="website.s_searchbar.autocomplete" t-inherit-mode="extension" owl="1">
        <xpath expr="." position="replace"><t/></xpath>
    </t>

</templates>
